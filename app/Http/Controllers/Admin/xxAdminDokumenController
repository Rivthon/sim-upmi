<?php
namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use App\Models\Dokumen;
use App\Models\KategoriDokumen;
use App\Models\SubKategoriDokumen;

class AdminDokumenController extends Controller
{
public function index()
{
    $dokumen = Dokumen::with(['kategoriDokumen', 'subKategori'])->latest()->get();
    return view('admin.dokumen-upload.index', compact('dokumen'));
}

    public function create()
    {
        $kategori = KategoriDokumen::with('subKategoris')->get();
        return view('admin.dokumen-upload.create', compact('kategori'));
    }

    public function store(Request $request)
    {
$request->validate([
    'kategori_dokumen_id' => 'required|exists:kategori_dokumens,id',
    'sub_kategori_dokumen_id' => 'nullable|exists:sub_kategori_dokumens,id',
    'judul' => 'required|string|max:255',
    'kode_dokumen' => 'required|string|max:100',
    'versi' => 'required|string|max:50',
    'tanggal_terbit' => 'required|date',
    'deskripsi' => 'nullable|string',
    'file_path' => 'nullable|file|mimes:pdf,doc,docx,xlsx,xls|max:5120'
]);

        $filePath = $request->file('file')->store('dokumen', 'public');

        Dokumen::create([
            'judul' => $request->judul,
            'deskripsi' => $request->deskripsi,
            'kategori_dokumen_id' => $request->kategori_dokumen_id,
            'sub_kategori_id' => $request->sub_kategori_id,
            'tipe' => $request->tipe,
            'file_path' => $filePath,
            'kode_dokumen' => $request->kode_dokumen,
            'versi' => $request->versi,
            'tanggal_terbit' => $request->tanggal_terbit,
        ]);

        return redirect()->route('admin.dokumen-upload.index')->with('success', 'Dokumen berhasil diunggah.');
    }
    public function edit(Dokumen $dokumen)
{
    $kategoriList = KategoriDokumen::all();
    $subKategoriList = SubKategoriDokumen::all();
    return view('admin.dokumen-upload.edit', compact('dokumen', 'kategoriList', 'subKategoriList'));
}

public function update(Request $request, Dokumen $dokumen)
{
    $validated = $request->validate([
    'kategori_dokumen_id' => 'required|exists:kategori_dokumens,id',
    'sub_kategori_dokumen_id' => 'nullable|exists:sub_kategori_dokumens,id',
    'judul' => 'required|string|max:255',
    'kode_dokumen' => 'required|string|max:100',
    'versi' => 'required|string|max:50',
    'tanggal_terbit' => 'required|date',
    'deskripsi' => 'nullable|string',
    'file_path' => 'nullable|file|mimes:pdf,doc,docx,xlsx,xls|max:5120'
    ]);

    if ($request->hasFile('file_path')) {
        // Hapus file lama jika ada
        if ($dokumen->file_path && \Storage::exists($dokumen->file_path)) {
            \Storage::delete($dokumen->file_path);
        }
        $validated['file_path'] = $request->file('file_path')->store('dokumen');
    }

    $dokumen->update($validated);

    return redirect()->route('admin.dokumen-upload.index')->with('success', 'Dokumen berhasil diperbarui.');
}
public function show(Dokumen $dokumen)
{
    return view('admin.dokumen-upload.show', compact('dokumen'));
}

}
